{%- liquid
  assign normalized_color = color_name | downcase | strip
  if normalized_color contains 'black' or normalized_color contains 'core black'
    echo '#17191c'
  elsif normalized_color contains 'navy'
    echo '#263650'
  elsif normalized_color contains 'royal blue'
    echo '#3155a6'
  elsif normalized_color contains 'blue'
    echo '#4f78aa'
  elsif normalized_color contains 'mint'
    echo '#9fc9bb'
  elsif normalized_color contains 'olive' or normalized_color contains 'army' or normalized_color contains 'khaki'
    echo '#667046'
  elsif normalized_color contains 'green'
    echo '#66806a'
  elsif normalized_color contains 'beige' or normalized_color contains 'sand'
    echo '#d8c8b3'
  elsif normalized_color contains 'cream' or normalized_color contains 'ivory'
    echo '#ece3d2'
  elsif normalized_color contains 'brown' or normalized_color contains 'mocha'
    echo '#76533d'
  elsif normalized_color contains 'gold' or normalized_color contains 'bronze'
    echo '#bd9a55'
  elsif normalized_color contains 'silver' or normalized_color contains 'grey' or normalized_color contains 'gray'
    echo '#aeb2b5'
  elsif normalized_color contains 'red' or normalized_color contains 'crimson'
    echo '#c94a4f'
  elsif normalized_color contains 'orange'
    echo '#e27a35'
  elsif normalized_color contains 'pink' or normalized_color contains 'rose'
    echo '#dfa0b5'
  elsif normalized_color contains 'purple' or normalized_color contains 'violet'
    echo '#765b91'
  elsif normalized_color contains 'yellow' or normalized_color contains 'volt'
    echo '#d9ce48'
  elsif normalized_color contains 'white' or normalized_color contains 'cloud'
    echo '#f4f4f1'
  else
    echo '#c8c9c5'
  endif
-%}
