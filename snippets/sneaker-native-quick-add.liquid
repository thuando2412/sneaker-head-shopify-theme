{% comment %}
  Native Dawn quick add adapted for an overlay CTA.

  Accepts:
  - product: Product object
  - section_id: Parent section id
  - context: Unique card context inside the section
  - label: Optional CTA label override
  - wrapper_class: Optional additional wrapper class
{% endcomment %}
{%- liquid
  assign quick_add_context = context | default: 'home-card'
  assign quick_add_key = section_id | append: '-' | append: quick_add_context | append: '-' | append: product.id
  assign product_form_id = 'quick-add-' | append: quick_add_key
  assign modal_id = 'QuickAdd-' | append: quick_add_key
  assign modal_info_id = 'QuickAddInfo-' | append: quick_add_key
  assign modal_close_id = 'ModalClose-' | append: quick_add_key
  assign qty_rules = false
  assign quick_add_label = label
  if quick_add_label == blank
    assign quick_add_label = 'products.product.choose_options' | t
  endif
  if product.selected_or_first_available_variant.quantity_rule.min > 1 or product.selected_or_first_available_variant.quantity_rule.max != null or product.selected_or_first_available_variant.quantity_rule.increment > 1
    assign qty_rules = true
  endif
-%}

<div class="sh-home-card-cta-wrap{% if wrapper_class != blank %} {{ wrapper_class }}{% endif %}">
  {%- if product.variants_count > 1 or qty_rules -%}
    <modal-opener data-modal="#{{ modal_id }}">
      <button
        id="{{ product_form_id }}-submit"
        type="button"
        name="add"
        class="sh-home-card-cta quick-add__submit button button--secondary"
        aria-haspopup="dialog"
        aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}"
        data-product-url="{{ product.url }}"
        data-choose-options-text="{{ quick_add_label | escape }}"
        data-sold-out-text="{{ 'products.product.sold_out' | t | escape }}"
        {% unless product.available %}disabled{% endunless %}
      >
        {{- quick_add_label -}}
        {%- render 'loading-spinner' -%}
      </button>
    </modal-opener>
  {%- else -%}
    <product-form data-section-id="{{ section_id }}">
      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          class="product-variant-id"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
        <button
          id="{{ product_form_id }}-submit"
          type="submit"
          name="add"
          class="sh-home-card-cta quick-add__submit button button--secondary"
          aria-live="polite"
          data-sold-out-message="true"
          data-add-to-cart-text="{{ quick_add_label | escape }}"
          data-sold-out-text="{{ 'products.product.sold_out' | t | escape }}"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          <span>
            {%- if product.selected_or_first_available_variant.available -%}
              {{- quick_add_label -}}
            {%- else -%}
              {{- 'products.product.sold_out' | t -}}
            {%- endif -%}
          </span>
          <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
          {%- render 'loading-spinner' -%}
        </button>
      {%- endform -%}
    </product-form>
  {%- endif -%}
</div>

{%- if product.variants_count > 1 or qty_rules -%}
  <quick-add-modal id="{{ modal_id }}" class="quick-add-modal">
    <div
      role="dialog"
      aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}"
      aria-modal="true"
      class="quick-add-modal__content global-settings-popup"
      tabindex="-1"
    >
      <button
        id="{{ modal_close_id }}"
        type="button"
        class="quick-add-modal__toggle"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      <div id="{{ modal_info_id }}" class="quick-add-modal__content-info"></div>
    </div>
  </quick-add-modal>
{%- endif -%}
