{%- liquid
  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank
    assign breadcrumb_collection = product.collections | first
  endif
-%}

<nav class="sneaker-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ routes.root_url }}">Home</a></li>
    <li><a href="{{ routes.all_products_collection_url }}">Catalog</a></li>
    {%- if breadcrumb_collection != blank -%}
      <li><a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title | escape }}</a></li>
    {%- endif -%}
    <li aria-current="page">{{ product.title | escape }}</li>
  </ol>
</nav>
