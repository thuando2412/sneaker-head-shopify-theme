{% style %}
  #shopify-section-{{ section.id }} .sh-campaigns { padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px; }
{% endstyle %}

<section class="sh-campaigns color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin"><h2 class="title inline-richtext h2">{{ section.settings.heading }}</h2></div>
    {% endif %}
    <div class="sh-campaigns__grid">
      {% for block in section.blocks %}
        {% liquid
          case block.settings.fallback_image
            when 'trail'
              assign fallback_image = 'activity-trail.jpg'
            else
              assign fallback_image = 'activity-everyday.jpg'
          endcase
        %}
        <article class="sh-campaign" {{ block.shopify_attributes }}>
          <div class="sh-campaign__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}
            {% else %}
              <img
                src="{{ fallback_image | asset_img_url: '1600x' }}"
                srcset="{{ fallback_image | asset_img_url: '400x' }} 400w, {{ fallback_image | asset_img_url: '600x' }} 600w, {{ fallback_image | asset_img_url: '800x' }} 800w, {{ fallback_image | asset_img_url: '1200x' }} 1200w, {{ fallback_image | asset_img_url: '1600x' }} 1600w"
                sizes="(min-width: 990px) 50vw, 100vw"
                alt="{{ block.settings.heading | escape }}"
                width="1122"
                height="1402"
                loading="lazy"
              >
            {% endif %}
          </div>
          <div class="sh-campaign__content">
            {% if block.settings.eyebrow != blank %}<p class="sh-eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
            {% if block.settings.copy != blank %}<div class="rte sh-campaign__copy">{{ block.settings.copy }}</div>{% endif %}
            {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sneaker campaigns",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Section heading", "default": "Built for how you move" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "campaign",
      "name": "Campaign tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Campaign image" },
        { "type": "select", "id": "fallback_image", "label": "Fallback image", "default": "everyday", "options": [{ "value": "everyday", "label": "Everyday" }, { "value": "trail", "label": "Trail" }] },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE EDIT" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Made to move." },
        { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Considered comfort for the way you move.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Sneaker campaigns", "blocks": [{ "type": "campaign" }, { "type": "campaign" }] }]
}
{% endschema %}
