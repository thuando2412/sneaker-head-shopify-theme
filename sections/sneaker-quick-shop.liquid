{% style %}
  #shopify-section-{{ section.id }} .sh-quick-shop { padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px; }
{% endstyle %}
<section class="sh-quick-shop color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <p class="sh-quick-shop__heading">{{ section.settings.heading | escape }}</p>
    {% endif %}
    <nav aria-label="{{ section.settings.navigation_label | default: section.settings.heading | escape }}">
      <ul class="sh-quick-shop__list list-unstyled" role="list">
        {% for block in section.blocks %}
          {% if block.settings.label != blank %}
            <li {{ block.shopify_attributes }}>
              <a class="sh-quick-shop__link" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}aria-disabled="true"{% endif %}>
                <span class="sh-quick-shop__icon" aria-hidden="true">
                  {% case forloop.index %}
                    {% when 1 %}<svg viewBox="0 0 24 24" fill="none"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/></svg>
                    {% when 2 %}<svg viewBox="0 0 24 24" fill="none"><path d="M7 18.5 10.5 12l2-6 2 6 3.5 2.5-3.5 1.5-2 5-2-5L7 18.5Z"/></svg>
                    {% when 3 %}<svg viewBox="0 0 24 24" fill="none"><path d="M3 15c4.5 1.4 9 .9 13.5-1.5L20 15v3H3v-3Z"/></svg>
                    {% when 4 %}<svg viewBox="0 0 24 24" fill="none"><path d="m4 17 8-11 8 11H4Zm8-11v14"/></svg>
                    {% else %}<svg viewBox="0 0 24 24" fill="none"><path d="M7 8h10l1 12H6L7 8Zm3 0V6a2 2 0 0 1 4 0v2"/></svg>
                  {% endcase %}
                </span>
                {{ block.settings.label | escape }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  </div>
</section>

{% schema %}
{
  "name": "Sneaker quick shop",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Eyebrow", "default": "QUICK SHOP" },
    { "type": "text", "id": "navigation_label", "label": "Navigation label", "default": "Quick shop" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "New arrivals" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Sneaker quick shop",
      "blocks": [{ "type": "link" }, { "type": "link" }, { "type": "link" }, { "type": "link" }]
    }
  ]
}
{% endschema %}
