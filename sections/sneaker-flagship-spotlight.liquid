{%- liquid
  assign spotlight_product = section.settings.product
  assign spotlight_heading = section.settings.heading
  if spotlight_heading == blank and spotlight_product != blank
    assign spotlight_heading = spotlight_product.title
  endif
  assign spotlight_link = section.settings.button_link
  if spotlight_link == blank and spotlight_product != blank
    assign spotlight_link = spotlight_product.url
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .sh-spotlight { padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px; }
{% endstyle %}
<section class="sh-spotlight color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="sh-spotlight__frame">
      <div class="sh-spotlight__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '400, 600, 800, 1000, 1400, 1800, 2000', sizes: '(min-width: 990px) 52vw, 100vw', loading: 'lazy', alt: section.settings.image.alt | default: spotlight_heading }}
        {% elsif spotlight_product != blank and spotlight_product.featured_media != blank %}
          {{ spotlight_product.featured_media.preview_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1400, 1600', sizes: '(min-width: 990px) 52vw, 100vw', loading: 'lazy', alt: spotlight_product.featured_media.alt | default: spotlight_product.title }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div class="sh-spotlight__content">
        {% if section.settings.eyebrow != blank %}<p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if spotlight_heading != blank %}<h2 class="sh-heading sh-heading--feature">{{ spotlight_heading | escape }}</h2>{% endif %}
        {% if section.settings.copy != blank %}<div class="rte sh-spotlight__copy">{{ section.settings.copy }}</div>{% endif %}
        {% if section.settings.show_price and spotlight_product != blank %}<p class="sh-spotlight__price">{{ spotlight_product.price | money_with_currency }}</p>{% endif %}
        <ul class="sh-spotlight__benefits list-unstyled" role="list">
          {% if section.settings.benefit_1 != blank %}<li><span aria-hidden="true">◎</span>{{ section.settings.benefit_1 | escape }}</li>{% endif %}
          {% if section.settings.benefit_2 != blank %}<li><span aria-hidden="true">✦</span>{{ section.settings.benefit_2 | escape }}</li>{% endif %}
          {% if section.settings.benefit_3 != blank %}<li><span aria-hidden="true">△</span>{{ section.settings.benefit_3 | escape }}</li>{% endif %}
        </ul>
        {% if section.settings.button_label != blank and spotlight_link != blank %}<a class="button" href="{{ spotlight_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sneaker flagship",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Spotlight image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FLAGSHIP PICK" },
    { "type": "text", "id": "heading", "label": "Heading override" },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Lightweight comfort and dependable cushioning for the miles that matter.</p>" },
    { "type": "checkbox", "id": "show_price", "label": "Show product price", "default": true },
    { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Responsive daily cushioning" },
    { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Breathable engineered mesh" },
    { "type": "text", "id": "benefit_3", "label": "Benefit 3", "default": "Durable everyday traction" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the pair" },
    { "type": "url", "id": "button_link", "label": "Button link override" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "Sneaker flagship" }]
}
{% endschema %}
