<section class="sh-home-section sh-home-collectors page-width">
  <div class="sh-home-head">
    <h2 class="sh-home-title">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.view_all_label != blank and section.settings.view_all_link != blank %}<a class="sh-home-link" href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_label | escape }}</a>{% endif %}
  </div>
  <sneaker-home-rail class="sh-home-editorial-rail" data-desktop-page-size="3" data-tablet-page-size="1" data-mobile-page-size="1">
  <div class="sh-home-collections__track" data-rail-list>
    {% for block in section.blocks %}
      {% assign tile_collection = block.settings.collection %}
      {% liquid
        assign editorial_asset = blank
        case block.settings.fallback_image
          when 'collab'
            assign editorial_asset = 'sh-home-collab.jpg'
          when 'summer'
            assign editorial_asset = 'sh-home-summer.png'
          when 'trail'
            assign editorial_asset = 'sh-home-trail.png'
          when 'marathon'
            assign editorial_asset = 'sh-home-marathon.png'
          when 'cushion'
            assign editorial_asset = 'sh-home-max-cushion.png'
          when 'rain'
            assign editorial_asset = 'sh-home-rain.jpg'
        endcase
        assign tile_link = tile_collection.url | default: block.settings.link | default: routes.all_products_collection_url
      %}
      {% if tile_collection != blank or block.settings.image != blank or editorial_asset != blank %}
        <a class="sh-home-collection-card" href="{{ tile_link }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '420, 620, 820, 1100, 1400', sizes: '(min-width: 1280px) 32vw, (min-width: 768px) 82vw, calc(100vw - 44px)', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.heading }}
          {% elsif editorial_asset != blank %}
            <img src="{{ editorial_asset | asset_img_url: '1400x' }}" alt="{{ block.settings.heading | escape }}" width="1400" height="875" loading="lazy">
          {% elsif tile_collection.featured_image != blank %}
            {{ tile_collection.featured_image | image_url: width: 1400 | image_tag: widths: '420, 620, 820, 1100, 1400', sizes: '(min-width: 1280px) 32vw, (min-width: 768px) 82vw, calc(100vw - 44px)', loading: 'lazy', alt: tile_collection.featured_image.alt | default: block.settings.heading }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          <div class="sh-home-collection-card__content">
            {% if block.settings.eyebrow != blank %}<div class="sh-home-collection-card__eyebrow">{{ block.settings.eyebrow | escape }}</div>{% endif %}
            <h3 class="sh-home-collection-card__title">{{ block.settings.heading | default: tile_collection.title | escape }}</h3>
          </div>
          <span class="sh-home-collection-card__cta">{{ block.settings.button_label | default: 'Shop now' | escape }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
  <div class="sh-home-rail__footer">
    <div class="sh-home-rail__status"><div class="sh-home-rail__progress" data-rail-progress aria-hidden="true"><span></span></div><span class="sh-home-rail__count" data-rail-count>1 / 1</span></div>
    <div class="sh-home-rail__controls">
      <button class="sh-home-icon-button" type="button" data-rail-prev aria-label="Previous collections">‹</button>
      <button class="sh-home-icon-button" type="button" data-rail-next aria-label="Next collections">›</button>
    </div>
  </div>
  </sneaker-home-rail>
  {% if section.settings.view_all_label != blank and section.settings.view_all_link != blank %}
    <a class="sh-home-mobile-view-all" href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_label | escape }}</a>
  {% endif %}
</section>
{% schema %}
{
  "name": "Sneaker collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collector's pick" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "blocks": [{ "type": "collection", "name": "Collection tile", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "url", "id": "link", "label": "Fallback link", "info": "Used until the selected collection is available." },
    { "type": "image_picker", "id": "image", "label": "Editorial image" },
    { "type": "select", "id": "fallback_image", "label": "Built-in prototype visual", "default": "collection", "options": [{ "value": "collection", "label": "Collection image" }, { "value": "collab", "label": "Limited collabs" }, { "value": "summer", "label": "Summer miles" }, { "value": "trail", "label": "Trail season" }, { "value": "marathon", "label": "Marathon prep" }, { "value": "cushion", "label": "Max cushion" }, { "value": "rain", "label": "Rainy-day ready" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New collection" },
    { "type": "text", "id": "heading", "label": "Heading override" },
    { "type": "text", "id": "copy", "label": "Description" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" }
  ] }],
  "max_blocks": 6,
  "presets": [{ "name": "Sneaker collections", "blocks": [{ "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
