<section class="sh-trust color-{{ section.settings.color_scheme }}">
  <div class="page-width sh-trust__grid">
    {% for block in section.blocks %}
      {% if block.settings.link != blank %}<a class="sh-trust__item sh-trust__item--link" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% else %}<article class="sh-trust__item" {{ block.shopify_attributes }}>{% endif %}
        <span class="sh-trust__number" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.copy }}</p>
        </div>
      {% if block.settings.link != blank %}</a>{% else %}</article>{% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Sneaker trust points",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Trust point",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Curated pairs" },
        { "type": "text", "id": "copy", "label": "Copy", "default": "A focused selection for running, everyday and trail." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Sneaker trust points",
    "blocks": [
      { "type": "point", "settings": { "heading": "Curated pairs", "copy": "A focused selection for running, everyday and trail." } },
      { "type": "point", "settings": { "heading": "Easy size support", "copy": "Clear fit guidance before you add to cart." } },
      { "type": "point", "settings": { "heading": "Ready to ship", "copy": "Fast, trackable delivery across Vietnam." } }
    ]
  }]
}
{% endschema %}
