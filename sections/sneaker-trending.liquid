{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign trending_sneakers_collection = section.settings.sneakers_collection | default: collections['new-arrivals']
  assign trending_apparel_collection = section.settings.apparel_collection | default: collections['clothing']
  assign trending_accessories_collection = section.settings.accessories_collection | default: collections['accessories']
%}

<sneaker-home-trending class="sh-home-section sh-home-trending page-width">
  <div class="sh-home-head sh-home-trending__head">
    <h2 class="sh-home-title" id="SneakerTrendingHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <div class="sh-home-trending__tabs-viewport">
      <div class="sh-home-audience-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }} category" data-trending-tabs>
        {% for category_index in (1..3) %}
          {% liquid
            case category_index
              when 1
                assign category_key = 'sneakers'
                assign category_label = section.settings.sneakers_label
                assign category_collection = trending_sneakers_collection
                assign category_url = category_collection.url | default: section.settings.sneakers_link | default: routes.all_products_collection_url
              when 2
                assign category_key = 'apparel'
                assign category_label = section.settings.apparel_label
                assign category_collection = trending_apparel_collection
                assign category_url = category_collection.url | default: section.settings.apparel_link | default: routes.all_products_collection_url
              when 3
                assign category_key = 'accessories'
                assign category_label = section.settings.accessories_label
                assign category_collection = trending_accessories_collection
                assign category_url = category_collection.url | default: section.settings.accessories_link | default: routes.all_products_collection_url
            endcase
          %}
          <button
            class="sh-home-audience-tab"
            type="button"
            role="tab"
            id="TrendingTab-{{ section.id }}-{{ category_key }}"
            aria-controls="TrendingPanel-{{ section.id }}-{{ category_key }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-trending-tab="{{ category_key }}"
            data-trending-url="{{ category_url }}"
          >{{ category_label | escape }}</button>
        {% endfor %}
      </div>
    </div>
    <div class="sh-home-trending__head-links">
      {% for category_index in (1..3) %}
        {% liquid
          case category_index
            when 1
              assign category_key = 'sneakers'
              assign category_collection = trending_sneakers_collection
              assign category_url = category_collection.url | default: section.settings.sneakers_link | default: routes.all_products_collection_url
            when 2
              assign category_key = 'apparel'
              assign category_collection = trending_apparel_collection
              assign category_url = category_collection.url | default: section.settings.apparel_link | default: routes.all_products_collection_url
            when 3
              assign category_key = 'accessories'
              assign category_collection = trending_accessories_collection
              assign category_url = category_collection.url | default: section.settings.accessories_link | default: routes.all_products_collection_url
          endcase
        %}
        <a class="sh-home-link" href="{{ category_url }}" data-trending-head-link="{{ category_key }}" {% unless forloop.first %}hidden{% endunless %}>{{ section.settings.view_all_label | escape }}</a>
      {% endfor %}
    </div>
  </div>

  {% for category_index in (1..3) %}
    {% liquid
      case category_index
        when 1
          assign category_key = 'sneakers'
          assign category_collection = trending_sneakers_collection
          assign category_url = category_collection.url | default: section.settings.sneakers_link | default: routes.all_products_collection_url
        when 2
          assign category_key = 'apparel'
          assign category_collection = trending_apparel_collection
          assign category_url = category_collection.url | default: section.settings.apparel_link | default: routes.all_products_collection_url
        when 3
          assign category_key = 'accessories'
          assign category_collection = trending_accessories_collection
          assign category_url = category_collection.url | default: section.settings.accessories_link | default: routes.all_products_collection_url
      endcase
    %}
    <div
      class="sh-home-trending__panel"
      id="TrendingPanel-{{ section.id }}-{{ category_key }}"
      role="tabpanel"
      aria-labelledby="TrendingTab-{{ section.id }}-{{ category_key }}"
      data-trending-panel="{{ category_key }}"
      {% unless forloop.first %}hidden{% endunless %}
    >
      <sneaker-home-banner-carousel class="sh-home-trending-banner" aria-label="{{ category_key | capitalize }} campaign banners">
        <div class="sh-home-trending-banner__track" data-banner-track>
          {% for block in section.blocks %}
            {% if block.settings.category == category_key %}
              {% liquid
                assign editorial_asset = blank
                case block.settings.fallback_image
                  when 'running'
                    assign editorial_asset = 'sh-home-running.png'
                  when 'summer'
                    assign editorial_asset = 'sh-home-summer.png'
                  when 'trail'
                    assign editorial_asset = 'sh-home-trail.png'
                  when 'clothing'
                    assign editorial_asset = 'sh-home-clothing.png'
                  when 'bags'
                    assign editorial_asset = 'sh-home-bags.jpg'
                  when 'care'
                    assign editorial_asset = 'sh-home-care.jpg'
                  when 'collab'
                    assign editorial_asset = 'sh-home-collab.jpg'
                  when 'everyday'
                    assign editorial_asset = 'sh-home-everyday.png'
                  when 'rain'
                    assign editorial_asset = 'sh-home-rain.jpg'
                endcase
                assign banner_link = block.settings.link | default: category_url
                assign image_position = '--sh-image-position: ' | append: block.settings.image.presentation.focal_point | append: ';'
              %}
              <a class="sh-home-trending-banner__slide" href="{{ banner_link }}" data-banner-slide {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '520, 760, 1000, 1400, 1800, 2400', sizes: '100vw', loading: 'lazy', class: 'sh-home-trending-banner__image', style: image_position, alt: block.settings.image.alt | default: block.settings.label }}
                {% elsif editorial_asset != blank %}
                  <img class="sh-home-trending-banner__image" src="{{ editorial_asset | asset_img_url: '2400x' }}" alt="{{ block.settings.label | escape }}" width="2400" height="1350" loading="lazy">
                {% else %}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg sh-home-trending-banner__image' }}
                {% endif %}
                <span class="sh-home-trending-banner__scrim" aria-hidden="true"></span>
                <span class="sh-home-trending-banner__cta">{{ block.settings.button_label | default: 'Shop now' | escape }}</span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
        <div class="sh-home-trending-banner__dots" data-banner-dots aria-label="Choose campaign banner"></div>
        <button class="sh-home-trending-banner__arrow sh-home-trending-banner__arrow--prev" type="button" data-banner-prev aria-label="Previous banner">‹</button>
        <button class="sh-home-trending-banner__arrow sh-home-trending-banner__arrow--next" type="button" data-banner-next aria-label="Next banner">›</button>
      </sneaker-home-banner-carousel>

      {% if category_collection != blank and category_collection.products_count > 0 %}
        <sneaker-home-rail class="sh-home-rail sh-home-trending__products" data-product-rail data-desktop-page-size="5" data-tablet-page-size="3" data-mobile-page-size="2">
          <ul class="sh-home-rail__list" data-rail-list role="list" aria-label="{{ category_key | capitalize }} trending products">
            {% liquid
              assign rendered_products = 0
              assign seen_colorway_families = '|'
            %}
            {% for product in category_collection.products limit: 50 %}
              {% liquid
                assign product_colorway_family = product.metafields.custom.colorway_family.value | first
                assign family_key = product_colorway_family.system.handle | default: product_colorway_family.id | default: product.id
                assign family_marker = '|' | append: family_key | append: '|'
              %}
              {% unless seen_colorway_families contains family_marker %}
                <li class="sh-home-rail__item">
                  {% render 'card-product', card_product: product, media_aspect_ratio: 'square', image_shape: 'default', show_secondary_image: true, show_vendor: true, show_colorways: true, show_rating: false, quick_add: false, quick_add_in_media: true, section_id: section.id %}
                </li>
                {% liquid
                  assign seen_colorway_families = seen_colorway_families | append: family_key | append: '|'
                  assign rendered_products = rendered_products | plus: 1
                %}
                {% if rendered_products >= section.settings.products_to_show %}{% break %}{% endif %}
              {% endunless %}
            {% endfor %}
          </ul>
          <div class="sh-home-rail__footer">
            <div class="sh-home-rail__status"><div class="sh-home-rail__progress" data-rail-progress><span></span></div><span class="sh-home-rail__count" data-rail-count aria-live="polite">1 / 1</span></div>
            <div class="sh-home-rail__controls">
              <button class="sh-home-icon-button" type="button" data-rail-prev aria-label="Previous products">‹</button>
              <button class="sh-home-icon-button" type="button" data-rail-next aria-label="Next products">›</button>
            </div>
          </div>
        </sneaker-home-rail>
      {% endif %}
      <a class="sh-home-mobile-view-all" href="{{ category_url }}">{{ section.settings.view_all_label | escape }}</a>
    </div>
  {% endfor %}
</sneaker-home-trending>

{% schema %}
{
  "name": "Sneaker trending",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trending now" },
    { "type": "text", "id": "sneakers_label", "label": "Sneakers tab label", "default": "Sneakers" },
    { "type": "collection", "id": "sneakers_collection", "label": "Sneakers collection" },
    { "type": "url", "id": "sneakers_link", "label": "Sneakers fallback link" },
    { "type": "text", "id": "apparel_label", "label": "Apparel tab label", "default": "Apparel" },
    { "type": "collection", "id": "apparel_collection", "label": "Apparel collection" },
    { "type": "url", "id": "apparel_link", "label": "Apparel fallback link" },
    { "type": "text", "id": "accessories_label", "label": "Accessories tab label", "default": "Accessories" },
    { "type": "collection", "id": "accessories_collection", "label": "Accessories collection" },
    { "type": "url", "id": "accessories_link", "label": "Accessories fallback link" },
    { "type": "range", "id": "products_to_show", "min": 5, "max": 30, "step": 1, "label": "Products per category", "default": 15 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" }
  ],
  "blocks": [{
    "type": "banner",
    "name": "Trending banner",
    "settings": [
      { "type": "select", "id": "category", "label": "Category", "default": "sneakers", "options": [{ "value": "sneakers", "label": "Sneakers" }, { "value": "apparel", "label": "Apparel" }, { "value": "accessories", "label": "Accessories" }] },
      { "type": "text", "id": "label", "label": "Accessible label", "default": "Trending campaign" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "image_picker", "id": "image", "label": "Banner image" },
      { "type": "select", "id": "fallback_image", "label": "Temporary fallback visual", "default": "running", "options": [{ "value": "running", "label": "Running" }, { "value": "summer", "label": "Summer" }, { "value": "trail", "label": "Trail" }, { "value": "clothing", "label": "Clothing" }, { "value": "bags", "label": "Bags" }, { "value": "care", "label": "Shoe care" }, { "value": "collab", "label": "Collab" }, { "value": "everyday", "label": "Everyday" }, { "value": "rain", "label": "Rain" }] },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" }
    ]
  }],
  "max_blocks": 9,
  "presets": [{ "name": "Sneaker trending", "blocks": [{ "type": "banner" }, { "type": "banner" }, { "type": "banner" }] }]
}
{% endschema %}
